# Sker Ledger Telemetry Server Environment Configuration

# PostgreSQL database connection string
# Format: postgres://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://sker:sker@localhost:5432/sker_ledger

# Optional: HTTP server listen address and port (default: 0.0.0.0:8080)
LISTEN_ADDR=0.0.0.0:8080

# Secret bearer token for authorizing event ingestion from CI / Sker CLI
# Must match the token configured in your CI secrets (SKER_LEDGER_TOKEN)
LEDGER_BEARER_TOKEN=sker-telemetry-secret-token-change-in-production
